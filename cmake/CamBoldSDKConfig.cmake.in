@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@_cb_json_imported@)
    find_dependency(nlohmann_json CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CamBoldSDKTargets.cmake")
set(CamBoldSDK_BACKEND "@CB_SDK_BACKEND@")
check_required_components(CamBoldSDK)
